# Copy this file to .env and fill in your own values
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rajakili
JWT_SECRET=change-this-to-a-long-random-string
# Admin login used by the seed script
ADMIN_EMAIL=admin@rajakili.demo
ADMIN_PASSWORD=change-me
# Your deployed frontend URL (for CORS). Use * while testing.
CLIENT_URL=http://localhost:5173
